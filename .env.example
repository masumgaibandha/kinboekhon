# Copy to .env.local and fill in. Never commit .env.local.

# Database (Atlas, AWS Mumbai ap-south-1)
# Local: the dev database, the URI ends in /kinboekhon_dev. Vercel: the production URI with no database path.
MONGODB_URI=
# Local only: production URI, read only by `npm run dev:clone`. Never used by the app, never set on Vercel.
MONGODB_URI_PROD=
# Old Virginia cluster, kept only as a backup reference on the local machine. Not read by the app, never set on Vercel.
MONGODB_URI_OLD_VIRGINIA=

# Admin login (Better Auth)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Used only by `npm run seed:admin`. Never set ADMIN_PASSWORD on Vercel.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Local only: dev admin in kinboekhon_dev, created by `npm run seed:dev-admin`. Never exists in production.
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile. Local development uses Cloudflare's test keys:
# site 1x00000000000000000000AA and secret 1x0000000000000000000000000000000AA always pass.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Random secret for hashing customer IPs (rate limits, admin tracking). Any long random string.
IP_HASH_SECRET=

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=kinboekhon

# Meta Pixel + Conversions API
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

# Steadfast courier official API (merchant panel API keys). Empty: the fraud check shows "Not connected".
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
