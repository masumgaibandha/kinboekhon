# Copy to .env.local and fill in. Never commit .env.local.

# Database (Atlas, AWS Mumbai ap-south-1)
MONGODB_URI=
# Old Virginia cluster, kept only as a backup reference on the local machine. Not read by the app, never set on Vercel.
MONGODB_URI_OLD_VIRGINIA=

# Admin login (Better Auth)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Used only by `npm run seed:admin`. Never set ADMIN_PASSWORD on Vercel.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=kinboekhon

# Meta Pixel + Conversions API
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=
