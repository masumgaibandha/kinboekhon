# Copy to .env.local and fill in. Never commit .env.local.

# Database (Atlas, AWS Mumbai ap-south-1)
# Local: the dev database, the URI ends in /kinboekhon_dev. Vercel: the production URI with no database path.
MONGODB_URI=
# Local only: production URI, read only by `npm run dev:clone`. Never used by the app, never set on Vercel.
MONGODB_URI_PROD=
# Old Virginia cluster, kept only as a backup reference on the local machine. Not read by the app, never set on Vercel.
MONGODB_URI_OLD_VIRGINIA=

# Admin login (Better Auth)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Used only by `npm run seed:admin`. Never set ADMIN_PASSWORD on Vercel.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Local only: dev admin in kinboekhon_dev, created by `npm run seed:dev-admin`. Never exists in production.
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile. Local development uses Cloudflare's test keys:
# site 1x00000000000000000000AA and secret 1x0000000000000000000000000000000AA always pass.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Random secret for hashing customer IPs (rate limits, admin tracking). Any long random string.
IP_HASH_SECRET=

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=kinboekhon

# Meta Pixel + Conversions API
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

# Meta Ads insights import, read only: the ad account id (act_...) and a system user token with ads_read only.
# Empty: /admin/ads shows "Meta Ads not connected".
META_ADS_ACCOUNT_ID=
META_ADS_TOKEN=
# Vercel Cron sends it as a Bearer token to /api/cron/meta-ads (daily import at 02:00 Dhaka time).
CRON_SECRET=

# Steadfast courier official API (merchant panel API keys). Live keys, no sandbox: outside production only the fraud check and balance may be called. Empty: "Not connected".
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=

# Pathao courier merchant API. Local: the public sandbox (base URL https://courier-api-sandbox.pathao.com and its
# test account). Vercel: live base URL https://api-hermes.pathao.com with the merchant panel credentials.
# Empty: the order page shows "Pathao is not connected".
PATHAO_BASE_URL=
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
# The pickup store id (sandbox: made with the store API; live: from the Pathao merchant panel store list).
PATHAO_STORE_ID=
# Any long random string; the same value goes in the Pathao panel webhook "Secret" field.
PATHAO_WEBHOOK_SECRET=

# Order SMS through BulkSMSBD: SMS_PROVIDER=bulksmsbd, the API key and the approved sender ID.
# Sent only from a production build on the production database. Otherwise, or when empty, each SMS is only written to the admin SMS log.
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=
